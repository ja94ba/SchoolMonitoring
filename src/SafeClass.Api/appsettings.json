{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore.Database.Command": "Warning" } },
  "AllowedHosts": "*",
  "Database": {
    "Path": "Data/safeclass.db",
    "ConnectionString": ""
  },
  "Jwt": {
    "Issuer": "SafeClass",
    "Audience": "SafeClass.Clients",
    "ExpiryMinutes": 480,
    "Key": ""
  },
  "Cors": { "AllowedOrigins": [] },
  "Frontend": { "Path": "../../frontend" },
  "RateLimiting": { "LoginPerMinute": 10, "DevicePerMinute": 120 },
  "SafeClass": {
    "HeartbeatOfflineThresholdSeconds": 60,
    "OfflineCheckIntervalSeconds": 15,
    "HeartbeatHistoryRetentionDays": 30,
    "HeartbeatHistoryMinIntervalSeconds": 60,
    "DemoModeEnabled": false
  },
  "Seed": { "Enabled": false, "DemoPassword": "", "DemoDeviceKey": "" },
  "Bootstrap": { "SchoolName": "", "SchoolCode": "", "AdminEmail": "", "AdminFullName": "", "AdminPassword": "" }
}
